{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4estfilms",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "4estfilms-db",
      "database_id": "1e31040d-c133-453a-be75-469cb171024c"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "4estfilms-media"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "12f63d34dd4f4c428ec4415b22ede78d"
    }
  ],

  // Cloudflare Email Service. No destination restriction — this sends to
  // subscribers, not to us — but the sender is pinned, so a bug cannot make
  // the Worker send as an address we do not own.
  //
  // `wrangler dev` simulates this: nothing leaves the machine and the
  // message bodies are written to files it names in the log. Add
  // "remote": true only when you intend to send real mail from a laptop.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@4estfilms.studio"]
    }
  ],

  // Custom domains, so the Worker answers on the apex and on www. Both
  // require 4estfilms.studio to be an active zone on this account; a custom
  // domain also provisions the certificate and the DNS record itself.
  "routes": [
    { "pattern": "4estfilms.studio", "custom_domain": true },
    { "pattern": "www.4estfilms.studio", "custom_domain": true }
  ]
}
