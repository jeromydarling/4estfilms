---
// The identity sting, played once as the page opens, then dissolved into the
// hero — which lands on the same mark the sting finishes assembling.
---

{/*
  Armed inline, before the hero paints, so the overlay never flashes in after
  the page is already visible. Everything that should skip the intro — a
  repeat view this session, reduced-motion, private mode, no JS at all —
  leaves it unarmed, and CSS keeps it hidden unless it has been armed.

  That default matters. This element covers the entire site at z-index
  10000, so if it is visible before anything has committed to taking it
  away, a browser that never runs the module below shows a black screen
  and nothing else.
*/}
<script is:inline>
  (function () {
    var d = document.documentElement;
    try {
      if (sessionStorage.getItem('4est.intro') === 'seen') return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      d.dataset.intro = 'armed';
      // The ceiling lives here, not in the module below, and that matters:
      // the overlay covers the whole site, so whatever puts it away has to
      // be code that is already running. If it waited on the module, a slow
      // network or a throw anywhere in that bundle would leave a visitor
      // staring at a black screen with no way past it.
      setTimeout(function () { d.dataset.intro = 'over'; }, 6000);
    } catch (e) {
      // Private mode can throw on sessionStorage. Skip the intro rather
      // than arm something we might not be able to disarm.
      d.dataset.intro = 'over';
    }
  })();
</script>

<div class="intro" data-intro-root>
  <video
    class="intro__video"
    muted
    playsinline
    autoplay
    preload="auto"
    poster="/brand/sting-end.webp"
    aria-hidden="true"
  >
    <source src="/brand/sting.webm" type="video/webm" />
    <source src="/brand/sting.mp4" type="video/mp4" />
  </video>

  <button class="intro__skip" type="button">Skip intro</button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-intro-root]');
  const armed = document.documentElement.dataset.intro === 'armed';

  if (root) {
    const video = root.querySelector<HTMLVideoElement>('.intro__video')!;
    const skip = root.querySelector<HTMLButtonElement>('.intro__skip')!;

    if (!armed) {
      root.remove();
    } else {
      let done = false;
      const end = () => {
        if (done) return;
        done = true;
        try { sessionStorage.setItem('4est.intro', 'seen'); } catch {}
        document.documentElement.dataset.intro = 'over';
        // let the dissolve finish before the node leaves the tree
        setTimeout(() => root.remove(), 1200);
      };

      video.addEventListener('ended', end);
      skip.addEventListener('click', end);
      // Esc should always get you out of a full-screen takeover
      addEventListener('keydown', (e) => { if (e.key === 'Escape') end(); });
      // A stalled or undecodable file must not hold the page hostage.
      // Deliberately shorter than the inline ceiling, so in the normal case
      // this is what ends the intro and the node gets cleaned up properly.
      video.addEventListener('error', end);
      const guard = setTimeout(end, 5000);
      video.addEventListener('ended', () => clearTimeout(guard));

      // Autoplay is permitted while muted, but if a policy still refuses,
      // drop straight through rather than showing a frozen frame.
      const p = video.play();
      if (p) p.catch(end);
    }
  }
</script>

<style>
  /* Hidden by default and shown only once the inline armer has said so.
     The overlay sits above the whole site, so "no JS yet" and "no JS at
     all" both have to mean "not covering anything". */
  .intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: #000;
    transition: opacity 1s var(--ease);
  }
  :global(html[data-intro='armed']) .intro { display: block; }
  :global(html[data-intro='over']) .intro {
    opacity: 0;
    pointer-events: none;
  }

  .intro__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* source is 738×414, so it is upscaled on desktop — the sting is a
       videotape treatment and reads as intentional, but a higher-resolution
       master would be better if one exists */
    image-rendering: auto;
  }

  .intro__skip {
    position: absolute;
    right: var(--pad);
    bottom: clamp(1.5rem, 4vw, 3rem);
    background: transparent;
    border: 1px solid rgba(242, 237, 227, .3);
    color: var(--bone);
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    padding: .7rem 1.2rem;
    cursor: pointer;
    opacity: .7;
    transition: opacity .4s var(--ease), border-color .4s var(--ease);
  }
  .intro__skip:hover,
  .intro__skip:focus-visible { opacity: 1; border-color: var(--blood-lift); }
</style>

<style is:global>
  /* Hold the hero's own entrance until the sting clears, so the mark arrives
     once rather than twice. Keyed on the same attribute as the overlay, so
     the inline ceiling releases the scroll lock too — a page you cannot
     scroll is its own kind of broken. */
  html[data-intro='armed'] .hero__mark img { animation-play-state: paused; }
  html[data-intro='armed'] { overflow: hidden; }
</style>
