---
import { known } from '../lib/known';
import { dollars } from '../lib/premiere';

interface Props {
  /** Button label. The default is the framing we use everywhere. */
  cta?: string;
  /** Shown above the fields. */
  label?: string;
}
const { cta = 'Join the Story', label = 'Join the story' } = Astro.props;
---

{/*
  The ask, in whichever form it currently takes.

  `known.mode` decides: 'give' is the Stripe checkout, 'enquiry' is a
  conversation. We are on 'enquiry' because Stripe locked the account
  mid-setup. Both live here rather than in two components so the page, the
  wording and the styling stay identical when the switch flips back — the
  only thing that should change that day is what the button does.

  One component, used on the home page and on /known/. The script binds every
  instance on the page.
*/}
{!known.open ? (
  <div class="soon">
    <p class="eyebrow eyebrow--accent">Not yet</p>
    <p class="soon__lede">Giving opens shortly.</p>
    <p class="dim">
      Put your address in anywhere on the site and you’ll hear when it does.
    </p>
  </div>
) : known.mode === 'give' ? (
  <form class="gift" data-gift>
    <p class="gift__label">{label}</p>
    <div class="gift__amounts">
      {known.suggestedCents.map((c) => (
        <button
          type="button"
          class="gift__amount"
          data-amount={c}
          aria-pressed={c === known.defaultCents ? 'true' : 'false'}
        >{dollars(c)}</button>
      ))}
    </div>
    <label class="gift__other">
      <span class="sr">Another amount, in dollars</span>
      <span class="gift__sign" aria-hidden="true">$</span>
      <input
        type="number"
        name="other"
        min={known.minimumCents / 100}
        max={known.maximumCents / 100}
        step="1"
        inputmode="numeric"
        placeholder="Another amount"
      />
    </label>
    <button class="gift__go" type="submit">{cta}</button>
    <p class="gift__msg" role="status" aria-live="polite"></p>
    <p class="dim gift__fine">
      Minimum {dollars(known.minimumCents)}, so card fees don’t eat the gift.
      Stripe emails your receipt; we never see your card.
    </p>
  </form>
) : (
  <form class="gift" data-enquiry>
    <p class="gift__label">{label}</p>
    <p class="dim gift__intro">
      We’re finishing the paperwork on our giving setup. Leave your details and
      we’ll come to you the moment it opens — personally, not from a queue.
    </p>

    <label class="field">
      <span class="field__label">Your name</span>
      <input type="text" name="name" autocomplete="name" placeholder="Jane Ross" />
    </label>

    <label class="field">
      <span class="field__label">Email</span>
      <input
        type="email" name="email" required autocomplete="email"
        placeholder="you@example.com" spellcheck="false"
      />
    </label>

    <label class="field">
      <span class="field__label">What you had in mind <span class="field__opt">optional</span></span>
      <select name="amount_band">
        <option value="">Rather not say yet</option>
        {known.bands.map((b) => <option value={b}>{b}</option>)}
      </select>
    </label>

    <label class="field">
      <span class="field__label">Anything you’d like to say <span class="field__opt">optional</span></span>
      <textarea name="message" rows="3" placeholder="Why this matters to you, or what you’d like to know."></textarea>
    </label>

    <label class="check">
      <input type="checkbox" name="wants_host" />
      <span>I’d also like to host a screening in my town</span>
    </label>

    {/* Bots fill every field they find; humans never see this one. */}
    <div class="hp" aria-hidden="true">
      <label>Website<input type="text" name="hp_url" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button class="gift__go" type="submit">{cta}</button>
    <p class="gift__msg" role="status" aria-live="polite"></p>
    <p class="dim gift__fine">
      No card is taken and nothing is charged. We’ll only write to you about
      this.
    </p>
  </form>
)}

<script>
  import { read, track } from '../lib/attribution';

  // ── the Stripe checkout, when known.mode is 'give' ──
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-gift]')) {
    const buttons = [...form.querySelectorAll<HTMLButtonElement>('.gift__amount')];
    const other = form.querySelector<HTMLInputElement>('input[name=other]')!;
    const go = form.querySelector<HTMLButtonElement>('.gift__go')!;
    const msg = form.querySelector<HTMLParagraphElement>('.gift__msg')!;

    let cents = Number(
      buttons.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.amount ?? 5000
    );
    const select = (b: HTMLButtonElement | null) => {
      for (const x of buttons) x.setAttribute('aria-pressed', String(x === b));
    };
    for (const b of buttons) {
      b.addEventListener('click', () => {
        cents = Number(b.dataset.amount);
        other.value = '';
        select(b);
      });
    }
    // Typing an amount deselects the presets, so what is charged is always
    // the thing that looks selected.
    other.addEventListener('input', () => {
      const v = Number(other.value);
      if (Number.isFinite(v) && v > 0) {
        cents = Math.round(v * 100);
        select(null);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      go.disabled = true;
      msg.dataset.state = '';
      msg.textContent = 'Opening checkout…';
      try {
        const attr = read();
        track('known_give_start');
        const res = await fetch('/api/known/checkout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            amount_cents: cents,
            utm_source: attr.utm_source,
            utm_campaign: attr.utm_campaign,
          }),
        });
        const body = (await res.json().catch(() => ({}))) as
          { ok?: boolean; url?: string; error?: string };
        if (body.ok && body.url) {
          location.href = body.url;
          return;
        }
        msg.dataset.state = 'err';
        msg.textContent = body.error ?? 'That didn’t go through. Try again?';
      } catch {
        msg.dataset.state = 'err';
        msg.textContent = 'Network trouble. Try again in a moment.';
      } finally {
        go.disabled = false;
      }
    });
  }

  // ── the conversation, when known.mode is 'enquiry' ──
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-enquiry]')) {
    const go = form.querySelector<HTMLButtonElement>('.gift__go')!;
    const msg = form.querySelector<HTMLParagraphElement>('.gift__msg')!;
    const email = form.querySelector<HTMLInputElement>('input[type=email]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!email.reportValidity()) return;
      go.disabled = true;
      msg.dataset.state = '';
      msg.textContent = 'Sending…';
      try {
        const attr = read();
        const f = new FormData(form);
        track('known_enquiry');
        const res = await fetch('/api/known/enquiry', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: f.get('name'),
            email: f.get('email'),
            amount_band: f.get('amount_band'),
            message: f.get('message'),
            wants_host: f.get('wants_host') === 'on',
            hp_url: f.get('hp_url'),
            utm_source: attr.utm_source,
            utm_campaign: attr.utm_campaign,
          }),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (body.ok) {
          // Replace the form rather than clearing it — a blank form after a
          // successful send reads as "that did not work, do it again".
          form.innerHTML =
            '<p class="eyebrow eyebrow--accent">Thank you</p>' +
            '<p class="soon__lede">We’ll come to you the moment giving opens.</p>' +
            '<p class="dim">There’s a note in your inbox confirming it. Reply to that ' +
            'any time — it comes straight to us.</p>';
          return;
        }
        msg.dataset.state = 'err';
        msg.textContent = body.error ?? 'That didn’t go through. Try again?';
      } catch {
        msg.dataset.state = 'err';
        msg.textContent = 'Network trouble. Try again in a moment.';
      } finally {
        go.disabled = false;
      }
    });
  }
</script>

<style>
  .gift__label {
    font-family: var(--mono); font-size: .68rem; letter-spacing: .2em;
    text-transform: uppercase; color: var(--bone-faint); margin: 0 0 1.2rem;
  }
  .gift__intro { font-size: .92rem; margin: 0 0 1.6rem; }

  /* A grid, not wrapping flex: with four chips the last one wrapped onto a
     row of its own on a phone and read as a different kind of button. */
  .gift__amounts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .5rem;
    margin-bottom: .8rem;
  }
  @media (max-width: 520px) {
    .gift__amounts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .gift__amount {
    background: transparent; border: 1px solid var(--rule); color: var(--bone);
    font-family: var(--display); font-size: 1.15rem; padding: .8rem .4rem;
    cursor: pointer;
    transition: border-color .3s var(--ease), color .3s var(--ease),
                transform .3s var(--ease);
  }
  .gift__amount[aria-pressed='true'] { border-color: var(--accent); color: var(--blood-lift); }
  .gift__amount:hover { border-color: var(--bone-faint); transform: translateY(-2px); }

  .gift__other { display: flex; align-items: baseline; gap: .4rem; }
  .gift__sign { font-family: var(--display); color: var(--bone-faint); }

  .field { display: block; margin-bottom: 1.3rem; }
  .field__label {
    display: block;
    font-family: var(--mono); font-size: .64rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--bone-faint); margin-bottom: .5rem;
  }
  .field__opt { text-transform: none; letter-spacing: .04em; opacity: .7; }

  .gift input, .gift select, .gift textarea {
    width: 100%; background: transparent; border: 0;
    border-bottom: 1px solid var(--rule); color: var(--bone);
    font-family: var(--display); font-size: 1.05rem; padding: .6rem .2rem;
    transition: border-color .4s var(--ease); min-width: 0;
  }
  .gift textarea { resize: vertical; line-height: 1.45; font-size: 1rem; }
  .gift select {
    appearance: none;
    /* the caret, drawn — a background image would be one more request */
    background-image: linear-gradient(45deg, transparent 50%, var(--bone-faint) 50%),
                      linear-gradient(135deg, var(--bone-faint) 50%, transparent 50%);
    background-position: right .9rem center, right .55rem center;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2rem;
    cursor: pointer;
  }
  /* the menu itself is drawn by the OS and does not inherit the page */
  .gift select option { background: var(--ink-2); color: var(--bone); }
  .gift input::placeholder, .gift textarea::placeholder { color: var(--bone-faint); }
  .gift input:focus, .gift select:focus, .gift textarea:focus {
    outline: 0; border-color: var(--blood-lift);
  }

  .check {
    display: flex; align-items: flex-start; gap: .7rem;
    font-size: .92rem; color: var(--bone-dim); cursor: pointer;
    margin-top: .4rem;
  }
  .check input {
    width: 1rem; height: 1rem; flex: 0 0 auto; margin-top: .15rem;
    accent-color: var(--blood-lift); cursor: pointer;
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .gift__go {
    width: 100%; margin-top: 1.8rem;
    background: var(--accent); border: 1px solid var(--accent); color: #fff;
    font-family: var(--sans); font-size: .74rem; font-weight: 600;
    letter-spacing: .2em; text-transform: uppercase; padding: 1rem 1.4rem;
    cursor: pointer;
    transition: filter .3s var(--ease), transform .3s var(--ease);
  }
  .gift__go:hover:not(:disabled) { filter: brightness(1.2); transform: translateY(-2px); }
  .gift__go:disabled { opacity: .5; cursor: progress; transform: none; }
  .gift__msg { font-size: .85rem; margin: .9rem 0 0; min-height: 1.2em; color: var(--bone-dim); }
  .gift__msg[data-state='err'] { color: #d98080; }
  .gift__fine { font-size: .8rem; margin-top: 1.1rem; }

  .soon__lede, .gift .soon__lede {
    font-family: var(--display); font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    line-height: 1.2; margin: .6rem 0 1.2rem;
  }
  .soon .dim, .gift .dim { font-size: .95rem; }

  @media (prefers-reduced-motion: reduce) {
    .gift__amount, .gift__go { transition: none; }
    .gift__amount:hover, .gift__go:hover:not(:disabled) { transform: none; }
  }
</style>
