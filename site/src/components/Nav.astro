---
const path = Astro.url.pathname;
// Short forms are used on narrow screens — the full title wraps onto the
// wordmark below ~560px.
const links = [
  ['/films/his-name-is-michael/', 'His Name is Michael', 'Michael'],
  ['/films/strung/', 'Strung', 'Strung'],
  ['/about/', 'About', 'About'],
];
const isHome = path === '/';
---

<header class="nav">
  <a href="/" class="nav__mark" aria-label="4est Films — home">
    <img src="/brand/4est-logo-bone.webp" alt="4est Films" width="1600" height="1316" />
  </a>

  <nav aria-label="Primary">
    <ul>
      {links.map(([href, label, short]) => (
        <li>
          <a href={href} aria-current={path === href ? 'page' : undefined}>
            <span class="full">{label}</span>
            <span class="short" aria-hidden="true">{short}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.4rem var(--pad);
    mix-blend-mode: difference;
  }

  .nav__mark { display: block; line-height: 0; }
  /* the drawn mark carries the identity; nothing should compete with it */
  .nav__mark img {
    width: auto;
    height: clamp(2rem, 3.2vw, 2.9rem);
    /* mix-blend-mode on the bar would invert the artwork, so the mark opts
       out and keeps its own value */
    mix-blend-mode: normal;
  }

  nav ul {
    display: flex;
    gap: clamp(1rem, 3vw, 2.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    text-decoration: none;
    color: #fff;
    font-size: .7rem;
    font-weight: 500;
    letter-spacing: .2em;
    text-transform: uppercase;
    opacity: .62;
    transition: opacity .4s var(--ease);
  }
  nav a:hover, nav a[aria-current='page'] { opacity: 1; }

  .short { display: none; }

  @media (max-width: 640px) {
    .nav { padding-block: 1rem; gap: 1rem; }
    .nav__mark img { height: 1.9rem; }
    nav a { font-size: .62rem; letter-spacing: .12em; }
    nav ul { gap: 1.1rem; }
  }

  /* below this the full title wraps and collides with the wordmark */
  @media (max-width: 560px) {
    .full { display: none; }
    .short { display: inline; }
  }
</style>
