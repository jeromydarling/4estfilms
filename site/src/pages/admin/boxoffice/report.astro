---
import Admin from '../../../layouts/Admin.astro';
import { hasSession } from '../../../lib/admin';
import { getEvent } from '../../../lib/boxoffice-db';
import {
  invoicesAt, offeringsAt, salesByCode, settlementsAt, soldBySku, stopTotals, waitlistAt,
} from '../../../lib/boxoffice-report';
import { TOUR, money, showTime } from '../../../lib/boxoffice';
import { SITE } from '../../../lib/email';
import { env } from 'cloudflare:workers';

export const prerender = false;

if (!(await hasSession(Astro.request))) return Astro.redirect('/admin/');

const slug = Astro.url.searchParams.get('slug') ?? '';
const event = await getEvent(slug);
if (!event) return Astro.redirect('/admin/boxoffice/');

const [totals] = await stopTotals(event.id);
const [items, codes, gifts, invoices, payments, waitlist, orders] = await Promise.all([
  soldBySku(event.id),
  salesByCode(event.id),
  offeringsAt(event.id),
  invoicesAt(event.id),
  settlementsAt(event.id),
  waitlistAt(event.id),
  env.DB
    .prepare(
      `SELECT o.id, o.buyer_name, o.buyer_email, o.channel, o.status, o.total_cents,
              o.fee_cents, o.refunded_cents, o.promo_code, o.operator, o.created_at,
              (SELECT COUNT(*) FROM bo_tickets t WHERE t.order_id = o.id AND t.void_at IS NULL) AS seats
         FROM bo_orders o WHERE o.event_id = ?1 ORDER BY o.created_at DESC LIMIT 200`
    )
    .bind(event.id)
    .all<Record<string, unknown>>(),
]);

const city = `${event.city}${event.region ? `, ${event.region}` : ''}`;
// Merch units are counted separately from seats: a family package is one
// bucket and one poster, and the table should say so rather than implying
// four of everything.
const merch = items.filter((i) => i.admits === 0);

const q = Astro.url.searchParams;
const flash = [
  q.get('comp') === 'done' && 'Comps issued.',
  q.get('comp') === 'noemail' && 'Comps issued, but the email failed — send the codes by hand.',
  q.get('comp') === 'name' && 'A comp needs a name for will-call.',
  q.get('invoice') === 'created' && 'Invoice created; the seats are held.',
  q.get('invoice') === 'paid' && 'Invoice paid; tickets minted and sent.',
  q.get('invoice') === 'noemail' && 'Invoice paid and tickets minted, but the email failed.',
  q.get('invoice') === 'cancelled' && 'Invoice cancelled; the seats are released.',
  q.get('invoice') === 'state' && 'That invoice isn’t open.',
  q.get('invoice') === 'name' && 'An invoice needs a name.',
  q.get('settled') === 'done' && 'Payment recorded.',
  q.get('settled') === 'removed' && 'Payment removed.',
  q.get('settled') === 'bad' && 'A payment needs a kind and an amount.',
  q.get('sent') && q.get('sent') !== 'empty' && `Sent to ${q.get('sent')} ${q.get('audience') === 'waitlist' ? 'on the waitlist' : 'ticket holders'}.`,
  q.get('sent') === 'empty' && 'A message needs a subject and some words.',
  q.get('refund') === 'done' && 'Refunded; tickets voided and stock returned.',
  q.get('refund') === 'already' && 'That order was already refunded.',
  q.get('refund') === 'failed' && 'Stripe refused the refund — nothing changed.',
  q.get('refund') === 'nokey' && 'No Stripe key, so nothing was refunded.',
].filter(Boolean) as string[];

const postShow =
  `Thank you for coming to His Name is Michael at ${event.venue}.\n\n` +
  `If the night moved you, a free-will offering — any amount — goes to the parish that opened its doors, ` +
  `and the making-of documentary and the songs from the film come with it.\n\n` +
  `Tell someone in the next town.`;
const unpaidInvoices = invoices.filter((i) => i.status === 'unpaid');
const openWaitlist = waitlist.filter((w) => !w.notified_at);
---

<Admin title={`Report — ${event.venue}`}>
  <h1>{event.venue}</h1>
  <p class="sub">{city} · {showTime(event.starts_at)}</p>

  <p class="acts">
    <a class="lnk" href="/admin/boxoffice/">← All stops</a>
    <a class="lnk" href={`/admin/boxoffice/event/?slug=${event.slug}`}>Edit stop</a>
    <a class="lnk" href={`/api/admin/boxoffice/export?what=stop&slug=${event.slug}`}>Stop CSV</a>
    <a class="lnk" href={`/api/admin/boxoffice/export?what=orders&slug=${event.slug}`}>Orders CSV</a>
    <a class="lnk" href={`/boxoffice/give/${event.slug}/sign/`} target="_blank" rel="noopener">Offering sign (print)</a>
    <a class="lnk" href={`/boxoffice/give/${event.slug}/`} target="_blank" rel="noopener">Offering page</a>
    <a class="lnk" href={`/admin/boxoffice/statement/?slug=${event.slug}`} target="_blank" rel="noopener">Settlement statement (print)</a>
    <a class="lnk" href={`/api/admin/boxoffice/export?what=waitlist&slug=${event.slug}`}>Waitlist CSV</a>
  </p>

  {flash.map((f) => <p class="flash">{f}</p>)}

  <h2>Door and host</h2>
  <div class="keys">
    <div class="key">
      <p class="label">Door PIN</p>
      <p class="key__big num">{event.door_pin ?? '—'}</p>
      <p class="muted small">
        Opens <span class="num">{SITE}/boxoffice/door/{event.slug}/</span> and nothing else. Give it to whoever runs the door.
        You’re signed in as admin, so every door opens for you without it — to see the gate, open the door in a private window.
      </p>
      <form method="post" action="/api/admin/boxoffice/event" class="inline">
        <input type="hidden" name="action" value="door_pin" />
        <input type="hidden" name="slug" value={event.slug} />
        <button type="submit" class="quiet">New PIN</button>
      </form>
    </div>
    <div class="key">
      <p class="label">Host’s page</p>
      <p class="muted small">
        Read-only for the parish coordinator: seats sold, their codes, what they’re owed. No names.
      </p>
      {event.host_token
        ? <p class="num small"><a href={`/boxoffice/host/${event.host_token}/`} target="_blank" rel="noopener">{SITE}/boxoffice/host/{event.host_token}/</a></p>
        : <p class="muted small">None yet — save the stop once.</p>}
      <form method="post" action="/api/admin/boxoffice/event" class="inline">
        <input type="hidden" name="action" value="host_token" />
        <input type="hidden" name="slug" value={event.slug} />
        <details class="sure">
          <summary class="quiet">New link</summary>
          <div class="sure__box">
            <p>The old link stops working the moment this lands.</p>
            <button type="submit" class="refund refund--yes">Yes, new link</button>
          </div>
        </details>
      </form>
    </div>
  </div>

  <h2>The money</h2>
  <div class="scroll">
    <table class="money">
      <tbody>
        <tr><td>Gross takings</td><td class="right num">{money(totals.gross_cents)}</td></tr>
        <tr><td>Less refunds</td><td class="right num">−{money(totals.refunded_cents)}</td></tr>
        <tr><td>Less Stripe fees <span class="muted">(as charged, not estimated)</span></td>
            <td class="right num">−{money(totals.fees_cents)}</td></tr>
        <tr><td>Less the house <span class="muted">(rental for this stop)</span></td>
            <td class="right num">−{money(totals.rental_cents)}</td></tr>
        <tr class="rule"><td><strong>Net</strong></td>
            <td class={`right num ${totals.net_cents < 0 ? 'bad' : ''}`}>
              <strong>{money(totals.net_cents)}</strong></td></tr>
        <tr><td>Tithe at {TOUR.tithePercent}% of net
              {totals.net_cents <= 0 && <span class="muted"> — nil, the stop did not clear</span>}</td>
            <td class="right num">{money(totals.tithe_cents)}</td></tr>
        <tr><td><strong>Retained by the tour</strong></td>
            <td class="right num"><strong>{money(totals.retained_cents)}</strong></td></tr>
        <tr class="rule"><td>Free-will offering — cash <span class="muted">(counted by hand)</span></td>
            <td class="right num">{money(totals.offering_cents)}</td></tr>
        <tr><td>Free-will offering — by card, {totals.offerings} {totals.offerings === 1 ? 'gift' : 'gifts'}
              <span class="muted">(less {money(totals.offering_fees_cents)} Stripe took)</span></td>
            <td class="right num">{money(totals.offering_card_cents - totals.offering_fees_cents)}</td></tr>
        <tr class="rule"><td><strong>To the parish</strong>
              <span class="muted">(tithe + offerings, passed on whole)</span></td>
            <td class="right num"><strong>{money(totals.parish_cents)}</strong></td></tr>
        <tr><td>Paid to the parish so far</td>
            <td class="right num">−{money(totals.tithe_paid_cents + totals.offering_paid_cents)}</td></tr>
        <tr><td><strong>{totals.parish_due_cents < 0 ? 'Overpaid' : 'Still due to the parish'}</strong></td>
            <td class={`right num ${totals.parish_due_cents > 0 ? 'bad' : ''}`}><strong>{money(Math.abs(totals.parish_due_cents))}</strong></td></tr>
        <tr class="rule"><td>Sales tax collected <span class="muted">(remitted by us; in none of the figures above)</span></td>
            <td class="right num">{money(totals.tax_cents)}</td></tr>
      </tbody>
    </table>
  </div>

  <form class="offering" method="post" action="/api/admin/boxoffice/event">
    <input type="hidden" name="action" value="offering" />
    <input type="hidden" name="slug" value={event.slug} />
    <label>
      <span class="label">Offering counted after the show</span>
      <input name="offering" type="text" inputmode="decimal"
             value={(totals.offering_cents / 100).toFixed(2)} />
    </label>
    <button type="submit">Save</button>
  </form>

  <h2>Who came</h2>
  <div class="scroll">
    <table>
      <tbody>
        <tr><td>Seats sold <span class="muted">(including {totals.comp_seats} comps)</span></td><td class="right num">{totals.attendees} of {totals.capacity}</td></tr>
        <tr><td>Held off the web <span class="muted">(the door can still sell them)</span></td><td class="right num">{event.holds ?? 0}</td></tr>
        <tr><td>Held by unpaid group invoices</td><td class="right num">{totals.reserved_admits}</td></tr>
        <tr><td>Checked in at the door</td><td class="right num">{totals.checked_in}</td></tr>
        <tr><td>No-shows</td><td class="right num">{totals.attendees - totals.checked_in}</td></tr>
        <tr><td>Orders <span class="muted">({totals.door_orders} taken at the door)</span></td>
            <td class="right num">{totals.orders}</td></tr>
        <tr><td>Cash taken at the window</td><td class="right num">{money(totals.cash_cents)}</td></tr>
        <tr><td>Revenue per attendee</td>
            <td class="right num">{money(totals.revenue_per_attendee_cents)}</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Sold by type</h2>
  <div class="scroll">
    <table>
      <thead><tr><th>Item</th><th class="right">Units</th><th class="right">Seats</th><th class="right">Gross</th></tr></thead>
      <tbody>
        {items.length ? items.map((i) => (
          <tr>
            <td>{i.name}</td>
            <td class="right num">{i.units}</td>
            <td class="right num">{i.admits || '—'}</td>
            <td class="right num">{money(i.gross_cents)}</td>
          </tr>
        )) : <tr><td colspan="4" class="empty">Nothing sold yet.</td></tr>}
      </tbody>
    </table>
  </div>

  <h2>Merchandise units</h2>
  <p class="muted small">
    Counted from what was bought, including the items inside packages.
  </p>
  <div class="scroll">
    <table>
      <thead><tr><th>Item</th><th class="right">Units</th><th class="right">Gross</th></tr></thead>
      <tbody>
        {merch.length ? merch.map((i) => (
          <tr><td>{i.name}</td><td class="right num">{i.units}</td><td class="right num">{money(i.gross_cents)}</td></tr>
        )) : <tr><td colspan="3" class="empty">No standalone merch sold.</td></tr>}
      </tbody>
    </table>
  </div>

  <h2>By partner code</h2>
  <div class="scroll">
    <table>
      <thead><tr><th>Code</th><th>Partner</th><th class="right">Orders</th><th class="right">Seats</th><th class="right">Gross</th></tr></thead>
      <tbody>
        {codes.filter((c) => c.orders > 0).length
          ? codes.filter((c) => c.orders > 0).map((c) => (
              <tr>
                <td class="num">{c.code}</td>
                <td>{c.partner}</td>
                <td class="right num">{c.orders}</td>
                <td class="right num">{c.seats}</td>
                <td class="right num">{money(c.gross_cents)}</td>
              </tr>
            ))
          : <tr><td colspan="5" class="empty">No code has been used at this stop.</td></tr>}
      </tbody>
    </table>
  </div>

  <h2>Settling up</h2>
  <p class="muted small">What has gone out: the tithe cheque, the offering handed over, the rental paid to the house.</p>
  <div class="scroll">
    <table>
      <thead><tr><th>Paid</th><th>What</th><th>How</th><th class="right">Amount</th><th></th></tr></thead>
      <tbody>
        {payments.length ? payments.map((p) => (
          <tr>
            <td class="num">{p.paid_at}</td>
            <td>{p.kind}{p.note ? <span class="muted"> — {p.note}</span> : null}</td>
            <td>{p.method ?? '—'}</td>
            <td class="right num">{money(p.amount_cents)}</td>
            <td class="right">
              <form method="post" action="/api/admin/boxoffice/settle">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="slug" value={event.slug} />
                <input type="hidden" name="id" value={String(p.id)} />
                <details class="sure">
                  <summary class="refund">Remove</summary>
                  <div class="sure__box">
                    <p>Remove this {money(p.amount_cents)} {p.kind} payment from the record?</p>
                    <button class="refund refund--yes" type="submit">Yes, remove</button>
                  </div>
                </details>
              </form>
            </td>
          </tr>
        )) : <tr><td colspan="5" class="empty">Nothing paid out yet.</td></tr>}
      </tbody>
    </table>
  </div>
  <form class="row" method="post" action="/api/admin/boxoffice/settle">
    <input type="hidden" name="slug" value={event.slug} />
    <label><span class="label">What</span>
      <select name="kind">
        <option value="tithe">Tithe to the parish</option>
        <option value="offering">Offering to the parish</option>
        <option value="rental">Rental to the house</option>
      </select></label>
    <label><span class="label">Amount</span><input name="amount" inputmode="decimal" placeholder="0.00" required /></label>
    <label><span class="label">Date</span><input name="paid_at" type="date" /></label>
    <label><span class="label">How</span><input name="method" placeholder="cheque #1042" /></label>
    <label class="grow"><span class="label">Note</span><input name="note" /></label>
    <button type="submit">Record payment</button>
  </form>

  <h2>Comps</h2>
  <p class="muted small">Seats given away: the pastor, the press, the family who fed the crew. Real tickets at $0.</p>
  <form class="row" method="post" action="/api/admin/boxoffice/comp">
    <input type="hidden" name="slug" value={event.slug} />
    <label><span class="label">Seats</span><input name="seats" type="number" min="1" max="100" value="2" required /></label>
    <label><span class="label">Name (for will-call)</span><input name="name" required /></label>
    <label><span class="label">Email (sends the tickets)</span><input name="email" type="email" /></label>
    <label class="grow"><span class="label">Why</span><input name="note" placeholder="pastor and family" /></label>
    <button type="submit">Issue comps</button>
  </form>

  <h2>Group invoices</h2>
  <p class="muted small">
    Forty seats for a parish, paid by cheque. The seats are held the moment the invoice exists;
    the tickets are minted and sent the moment it’s marked paid.
  </p>
  <div class="scroll">
    <table>
      <thead><tr><th>Created</th><th>Who</th><th class="right">Seats</th><th class="right">Amount</th><th>Status</th><th></th></tr></thead>
      <tbody>
        {invoices.length ? invoices.map((i) => (
          <tr class={i.status === 'cancelled' ? 'off' : ''}>
            <td class="num">{i.created_at.slice(0, 10)}</td>
            <td>{i.buyer_name}<br /><span class="muted">{i.buyer_email ?? ''}{i.note ? ` · ${i.note}` : ''}</span></td>
            <td class="right num">{i.status === 'unpaid' ? i.reserved_admits : i.seats}</td>
            <td class="right num">{money(i.total_cents)}</td>
            <td>{i.status}{i.reference ? <span class="muted"> · {i.reference}</span> : null}</td>
            <td class="right">
              {i.status === 'unpaid' && (
                <>
                  <form method="post" action="/api/admin/boxoffice/invoice" class="inline">
                    <input type="hidden" name="action" value="paid" />
                    <input type="hidden" name="slug" value={event.slug} />
                    <input type="hidden" name="order_id" value={String(i.id)} />
                    <input name="reference" placeholder="cheque #" class="tiny" />
                    <button class="refund" type="submit">Mark paid</button>
                  </form>
                  <form method="post" action="/api/admin/boxoffice/invoice" class="inline">
                    <input type="hidden" name="action" value="cancel" />
                    <input type="hidden" name="slug" value={event.slug} />
                    <input type="hidden" name="order_id" value={String(i.id)} />
                    <details class="sure">
                      <summary class="refund">Cancel</summary>
                      <div class="sure__box">
                        <p>Cancel this invoice and release its {i.reserved_admits} seats?</p>
                        <button class="refund refund--yes" type="submit">Yes, cancel it</button>
                      </div>
                    </details>
                  </form>
                </>
              )}
            </td>
          </tr>
        )) : <tr><td colspan="6" class="empty">No group invoices.</td></tr>}
      </tbody>
    </table>
  </div>
  <form class="row" method="post" action="/api/admin/boxoffice/invoice">
    <input type="hidden" name="slug" value={event.slug} />
    <input type="hidden" name="action" value="create" />
    <label><span class="label">Seats</span><input name="seats" type="number" min="1" max="2000" value="20" required /></label>
    <label><span class="label">Group</span><input name="name" placeholder="St Mary’s, Yankton" required /></label>
    <label><span class="label">Email (gets the tickets)</span><input name="email" type="email" /></label>
    <label><span class="label">Rate each</span><input name="rate" inputmode="decimal" placeholder="stop price" /></label>
    <label class="grow"><span class="label">Note</span><input name="note" /></label>
    <button type="submit">Create invoice</button>
  </form>
  {!!unpaidInvoices.length && (
    <p class="muted small">{unpaidInvoices.reduce((n, i) => n + i.reserved_admits, 0)} seats held by {unpaidInvoices.length} open {unpaidInvoices.length === 1 ? 'invoice' : 'invoices'}.</p>
  )}

  <h2>Write to this stop</h2>
  <div class="two">
    <form class="msg" method="post" action="/api/admin/boxoffice/notify">
      <input type="hidden" name="slug" value={event.slug} />
      <input type="hidden" name="audience" value="buyers" />
      <p class="label">The morning after — to everyone with a seat</p>
      <input name="subject" value={`Thank you for coming — ${event.venue}`} required />
      <textarea name="message" rows="6">{postShow}</textarea>
      <p class="muted small">Ends with a button to the offering page. Sends to each address once.</p>
      <details class="sure">
        <summary class="go">Send to ticket holders</summary>
        <div class="sure__box">
          <p>Send this to every ticket holder at {event.venue}, once each?</p>
          <button type="submit">Yes, send it</button>
        </div>
      </details>
    </form>
    <form class="msg" method="post" action="/api/admin/boxoffice/notify">
      <input type="hidden" name="slug" value={event.slug} />
      <input type="hidden" name="audience" value="waitlist" />
      <p class="label">A second showing — to the waitlist ({openWaitlist.length} waiting{waitlist.length - openWaitlist.length ? `, ${waitlist.length - openWaitlist.length} already told` : ''})</p>
      <input name="subject" value={`Seats opened at ${event.venue}`} required />
      <textarea name="message" rows="6">{`You asked to hear if seats opened at ${event.venue}. They have — the link below takes you straight to them.`}</textarea>
      <p class="muted small">Ends with a button to the ticket page. Each person is written to once.</p>
      {openWaitlist.length ? (
        <details class="sure">
          <summary class="go">Send to the waitlist</summary>
          <div class="sure__box">
            <p>Send this to the {openWaitlist.length} {openWaitlist.length === 1 ? 'person' : 'people'} waiting?</p>
            <button type="submit">Yes, send it</button>
          </div>
        </details>
      ) : (
        <button type="submit" disabled>Send to the waitlist</button>
      )}
    </form>
  </div>

  <h2>Card offerings</h2>
  <p class="muted small">
    Through the QR on the sign. The cash in the basket is typed in above.
  </p>
  <div class="scroll">
    <table>
      <thead><tr><th>When</th><th>Giver</th><th class="right">Gift</th><th class="right">Fee</th></tr></thead>
      <tbody>
        {gifts.length ? gifts.map((g) => (
          <tr class={g.refunded_cents >= g.amount_cents ? 'off' : ''}>
            <td class="num">{g.created_at.slice(0, 16).replace('T', ' ')}</td>
            <td>{g.giver_name ?? '—'}<br /><span class="muted">{g.giver_email ?? ''}</span></td>
            <td class="right num">{money(g.amount_cents)}</td>
            <td class="right num">{money(g.fee_cents)}</td>
          </tr>
        )) : <tr><td colspan="4" class="empty">No card offerings yet.</td></tr>}
      </tbody>
    </table>
  </div>

  <h2>Orders</h2>
  <div class="scroll">
    <table>
      <thead>
        <tr><th>When</th><th>Buyer</th><th>How</th><th class="right">Seats</th>
            <th class="right">Paid</th><th class="right">Fee</th><th>Code</th><th></th></tr>
      </thead>
      <tbody>
        {(orders.results ?? []).length ? (orders.results ?? []).map((o) => (
          <tr class={o.status === 'refunded' ? 'off' : ''}>
            <td class="num">{String(o.created_at ?? '').slice(0, 16).replace('T', ' ')}</td>
            <td>{String(o.buyer_name ?? '—')}<br /><span class="muted">{String(o.buyer_email ?? '')}</span></td>
            <td>{String(o.channel).replace('door_', 'door ')}{o.operator ? ` · ${o.operator}` : ''}</td>
            <td class="right num">{String(o.seats)}</td>
            <td class="right num">{money(Number(o.total_cents))}</td>
            <td class="right num">{money(Number(o.fee_cents))}</td>
            <td class="num">{String(o.promo_code ?? '')}</td>
            <td class="right">
              {o.status === 'refunded'
                ? <span class="muted">refunded</span>
                : (
                  <form method="post" action="/api/admin/boxoffice/refund">
                    <input type="hidden" name="order_id" value={String(o.id)} />
                    <input type="hidden" name="slug" value={event.slug} />
                    <details class="sure">
                      <summary class="refund">Refund</summary>
                      <div class="sure__box">
                        <p>Refund {money(Number(o.total_cents))} and void {String(o.seats)} {Number(o.seats) === 1 ? 'ticket' : 'tickets'}? This cannot be undone.</p>
                        <button class="refund refund--yes" type="submit">Yes, refund</button>
                      </div>
                    </details>
                  </form>
                )}
            </td>
          </tr>
        )) : <tr><td colspan="8" class="empty">No orders yet.</td></tr>}
      </tbody>
    </table>
  </div>
</Admin>

