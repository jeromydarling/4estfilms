---
import Base from '../../layouts/Base.astro';
import Give from '../../components/Give.astro';
import { known } from '../../lib/known';
export const prerender = true;
---

<Base
  title="KNOWN — become part of the story"
  description="KNOWN is the nonprofit storytelling initiative behind 4est Films' purpose-driven projects. Every donation helps bring meaningful independent films to life."
  ogImage="/og/known.jpg"
  ogImageAlt="KNOWN — the non-profit arm of 4est Films"
>
  <section class="top wrap">
    <p class="eyebrow" data-reveal>The non-profit arm of 4est Films</p>
    <h1 class="display top__title" data-reveal style="--delay:80ms">{known.name}</h1>
    <p class="lede top__lede" data-reveal style="--delay:180ms">
      Support independent films that inspire hope, awaken purpose, and remind
      people what it means to be human.
    </p>
  </section>

  <section class="section wrap about">
    <div class="about__body">
      <p data-reveal>
        {known.name} is the nonprofit storytelling initiative behind many of
        4est Films’ purpose-driven projects.
      </p>
      <p data-reveal style="--delay:60ms">
        Founded on the belief that stories can transform lives, {known.name}
        exists to remove financial barriers that often prevent meaningful
        independent films from being made.
      </p>
      <p data-reveal style="--delay:120ms">
        Every contribution helps us continue producing films centered around
        faith, redemption, hope, courage, beauty, and the shared human
        experience.
      </p>

      <p class="eyebrow about__missionlabel" data-reveal>Our mission is simple</p>
      <ul class="mission" data-reveal style="--delay:60ms">
        {known.mission.map((line) => <li>{line}</li>)}
      </ul>

      <p data-reveal style="--delay:120ms">
        <a class="link" href={known.site} target="_blank" rel="noopener">
          Learn more about {known.name} <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <div class="about__box" data-reveal style="--delay:140ms">
      <Give cta="Join the Story" label="Join the story" />
    </div>
  </section>

  <section class="section wrap thanks">
    <p class="eyebrow" data-reveal>Every supporter becomes part of the story</p>
    <h2 class="h2" data-reveal>You are in the credits</h2>
    <p class="dim thanks__note" data-reveal style="--delay:120ms">
      Every person who donates to {known.name} becomes part of the films they
      help create.
    </p>

    <div class="thanks__cols">
      <div data-reveal>
        <p class="thanks__label">Every donor receives</p>
        <ul class="ticks">
          {known.recognition.every.map((r) => <li>{r}</li>)}
        </ul>
      </div>
      <div data-reveal style="--delay:120ms">
        <p class="thanks__label">Major supporters may also receive</p>
        <ul class="dots">
          {known.recognition.major.map((r) => <li>{r}</li>)}
        </ul>
        <p class="dim thanks__aside">
          We love welcoming our supporters into the filmmaking process whenever
          possible.
        </p>
      </div>
    </div>

    <p class="dim thanks__quiet" data-reveal>
      Would rather not be named in the credits? Reply to your receipt and we’ll
      leave your name off. For gifts larger than the form allows, write to
      <a href={`mailto:${known.contact}`}>{known.contact}</a> — we would rather
      talk to you.
    </p>
  </section>
</Base>

<style>
  .top { padding-top: clamp(9rem, 20vw, 15rem); padding-bottom: clamp(1rem, 3vw, 2rem); }
  .top__title { font-size: clamp(3.4rem, 12vw, 10rem); line-height: .9; margin: .6rem 0 0; letter-spacing: .04em; }
  .top__lede { margin-top: 2.2rem; max-width: 34ch; }

  .about {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    align-items: start;
    border-top: 1px solid var(--rule);
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; } }
  .about__body p { color: var(--bone-dim); max-width: 46ch; }
  .about__body p + p { margin-top: 1.1rem; }
  .about__missionlabel { margin: 2.4rem 0 1rem; }
  .mission { list-style: none; margin: 0 0 2rem; padding: 0; }
  .mission li {
    font-family: var(--display);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.35;
    padding: .38rem 0;
    color: var(--bone);
  }

  .about__box {
    border: 1px solid var(--rule);
    padding: clamp(1.6rem, 4vw, 2.6rem);
    position: sticky;
    top: 6rem;
  }
  @media (max-width: 900px) { .about__box { position: static; } }

  .thanks { border-top: 1px solid var(--rule); padding-top: clamp(2.5rem, 6vw, 4rem); }
  .thanks__note { margin: 1.2rem 0 0; max-width: 46ch; }
  .thanks__cols {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    margin-top: 2.6rem;
  }
  .thanks__label {
    font-family: var(--mono); font-size: .66rem; letter-spacing: .18em;
    text-transform: uppercase; color: var(--bone-faint); margin: 0 0 1rem;
  }
  .ticks, .dots { list-style: none; margin: 0; padding: 0; }
  .ticks li, .dots li {
    position: relative;
    padding: .45rem 0 .45rem 1.7rem;
    color: var(--bone-dim);
    font-size: .95rem;
    max-width: 42ch;
  }
  .ticks li::before {
    content: '✓';
    position: absolute; left: 0; top: .45rem;
    color: var(--blood-lift); font-size: .9rem;
  }
  .dots li::before {
    content: '';
    position: absolute; left: .3rem; top: 1.05rem;
    width: 4px; height: 4px; border-radius: 50%;
    background: var(--bone-faint);
  }
  .thanks__aside { margin-top: 1.2rem; font-size: .88rem; font-style: italic; max-width: 40ch; }
  .thanks__quiet { margin-top: 2.6rem; font-size: .88rem; max-width: 52ch; }
  .thanks__quiet a { color: var(--blood-lift); }
</style>
