---
import Base from '../layouts/Base.astro';
import Notify from '../components/Notify.astro';
import RouteMap from '../components/RouteMap.astro';

const hero = 'key/hero-prayer.webp';
export const prerender = true;

// The route as the data holds it: legs in order, cities in route order,
// windows at month level. Nothing here names a venue — none is confirmed —
// and nothing promises a day-level date. Sioux Falls is rostered under
// Leg 2 in the data but opens the tour as the world premiere, so it is
// presented there and pointed to from the Leg 2 section.
const legs = [
  {
    kicker: 'Leg 1 · The Launch',
    name: 'California',
    window: 'February – March 2027',
    color: '#0e7c86',
    intro:
      'The tour launches in California — opening in Los Angeles and running up the coast to close in Sacramento.',
    cities: ['Los Angeles, CA', 'San Diego, CA', 'San Francisco, CA', 'Oakland, CA', 'Sacramento, CA'],
    callout:
      'The California leg closes in <strong>Sacramento</strong> — the city where Bishop Patrick Manogue, the real priest behind this film’s Father Manogue, served as its first bishop, and where he is buried.',
  },
  {
    kicker: 'Leg 2',
    name: 'Upper Midwest Opening',
    window: 'March 2027',
    color: '#b4552d',
    intro:
      'The home leg. The spring block opens in the Twin Cities and rolls north and west across Minnesota into Fargo.',
    cities: ['Minneapolis, MN', 'Columbia Heights, MN', 'Duluth, MN', 'St. Cloud, MN', 'Morris, MN', 'Fargo, ND'],
    callout:
      'Sioux Falls, South Dakota — the eighth stop on this leg’s route — opens the whole tour early, as the world premiere above.',
  },
  {
    kicker: 'Leg 3',
    name: 'Midwest / Great Lakes',
    window: 'April 2027',
    color: '#c07f16',
    intro:
      'Across the heartland and up the Lake Michigan shore, through Chicago and Michigan, then down into Indiana and Ohio.',
    cities: [
      'Des Moines, IA', 'Madison, WI', 'Milwaukee, WI', 'Chicago, IL', 'Manistee, MI',
      'Frankfort, MI', 'Traverse City, MI', 'Franklin, IN', 'Yellow Springs, OH', 'Athens, OH',
    ],
  },
  {
    kicker: 'Leg 4',
    name: 'East Coast',
    window: 'April – May 2027',
    color: '#2e7d5b',
    intro:
      'East to the Atlantic — Pennsylvania, New York, Connecticut and Massachusetts, ending at the end of the line in Maine.',
    cities: [
      'Phoenixville, PA', 'New York, NY', 'Brooklyn, NY', 'Bantam, CT',
      'Cambridge, MA', 'Brookline, MA', 'Rockland, ME',
    ],
  },
  {
    kicker: 'Leg 5',
    name: 'Southern',
    window: 'May 2027',
    color: '#2f6db3',
    intro:
      'South through the mid-Atlantic and the Carolinas, across Georgia and Alabama to the Gulf, closing in Louisiana.',
    cities: ['Silver Spring, MD', 'Charlotte, NC', 'Atlanta, GA', 'Montgomery, AL', 'Tampa, FL', 'Arabi, LA'],
  },
  {
    kicker: 'Leg 6',
    name: 'Texas / Southwest',
    window: 'June 2027',
    color: '#a03d63',
    intro:
      'Texas first — Houston, Dallas, Austin — then north to Wichita and Kansas City, and west to Santa Fe.',
    cities: ['Houston, TX', 'Dallas, TX', 'Austin, TX', 'Wichita, KS', 'Kansas City, MO', 'Santa Fe, NM'],
  },
  {
    kicker: 'Leg 7 · Northern Plains & Iowa',
    name: 'Return + Northwest',
    window: 'July 2027',
    color: '#6b7c2e',
    intro: 'The long way home: the Pacific Northwest, then east across the northern plains and Iowa.',
    cities: [
      'Seattle, WA', 'Portland, OR', 'Coos Bay, OR', 'Moscow, ID',
      'Scottsbluff, NE', 'Kearney, NE', 'Humboldt, IA', 'Winterset, IA',
    ],
  },
];
---

<Base
  world="frontier"
  title="The Full Route — His Name Is Michael"
  description="The planned route of the His Name Is Michael screening tour: 50+ stops, 60+ nights, December 2026 – July 2027. Cities and dates announced first to the email list."
  ogImage="/og/hnim.jpg"
  ogImageAlt="His Name is Michael — the screening tour, 2026–2027"
>
  <!-- ── hero ── -->
  <section class="hero">
    <div class="hero__art" data-parallax="0.06">
      <img src={`/stills/${hero}`} alt="" loading="eager" decoding="async" />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="wrap hero__body">
      <p class="eyebrow eyebrow--accent" data-reveal>The Screening Tour · 2026–2027</p>
      <h1 class="display hero__title" data-reveal style="--delay:80ms">The Full Route</h1>
      <p class="lede" data-reveal style="--delay:240ms">
        The only priest in Nevada battles demons and outlaws for the soul of the
        boy with no name — carried to fifty-plus cities, one screening at a time.
      </p>
      <p class="hero__stats" data-reveal style="--delay:360ms">
        50+ stops · 60+ nights · December 2026 — July 2027
      </p>
    </div>
  </section>

  <!-- ── the map ── -->
  <section class="mapsec wrap">
    <div class="mapsec__frame" data-reveal>
      <RouteMap />
    </div>
    <p class="totals" data-reveal>50+ Stops · 60+ Nights</p>
    <p class="honest dim" data-reveal style="--delay:120ms">
      This is a planned route. The cities are set; the dates are announced
      first to the email list.
    </p>
  </section>

  <!-- ── the route, leg by leg ── -->
  <section class="section wrap">
    <div class="route-col">
      <article class="premiere" data-reveal>
        <p class="eyebrow premiere__kicker">The World Premiere — Planned</p>
        <h2 class="h2 premiere__city">Sioux Falls, SD</h2>
        <p class="when">December 2026</p>
        <p class="dim premiere__body">
          Before the tour rolls, the film opens with a planned Christmas world
          premiere in Sioux Falls — the film’s financial home, and the city
          where <em>Strung</em>, the team’s earlier short, first premiered.
          Exact dates will be announced first to the email list.
        </p>
      </article>

      {legs.map((leg, i) => (
        <article class="leg" style={`--leg:${leg.color}`} data-reveal>
          <p class="leg__kicker">{leg.kicker}</p>
          <h3 class="leg__name">{leg.name}</h3>
          <p class="leg__window">{leg.window}</p>
          <p class="dim leg__intro">{leg.intro}</p>
          <ul class="cities">
            {leg.cities.map((c) => <li>{c}</li>)}
          </ul>
          {leg.callout && <p class="dim callout" set:html={leg.callout} />}
          {i === legs.length - 1 && (
            <p class="dim route-note">
              Route is planned and subject to change. Exact dates announced
              first to the email list.
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- ── the list ── -->
  <Notify
    film="his-name-is-michael"
    heading="Know what comes next."
    note="One email when there is something real to say. Nothing else, ever. Dates for every stop on this route are announced to the list before anywhere else."
  />
</Base>

<style>
  /* ── hero (same construction as the film page) ── */
  .hero {
    position: relative;
    min-height: 92svh;
    display: grid;
    align-content: end;
    padding-bottom: clamp(3rem, 9vw, 7rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__art { position: absolute; inset: -10% 0; z-index: -2; }
  .hero__art img {
    width: 100%; height: 100%;
    object-fit: cover;
    transform: translateY(var(--shift, 0)) scale(1.08);
    filter: brightness(.5) sepia(.25) saturate(1.1);
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to bottom, rgba(11,17,24,.55), rgba(11,17,24,.2) 40%, var(--night) 96%),
      radial-gradient(80% 60% at 20% 90%, rgba(217,164,65,.14), transparent 70%);
  }
  .hero__title { margin-bottom: 2rem; }
  .hero__stats {
    margin-top: 2.4rem;
    font-family: var(--mono);
    font-size: .74rem;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--lantern);
  }

  /* ── map ── */
  .mapsec { padding-top: clamp(2.5rem, 6vw, 4.5rem); text-align: center; }
  .mapsec__frame { max-width: 1080px; margin-inline: auto; }
  .totals {
    font-family: var(--display);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--lantern);
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }
  .honest { font-style: italic; margin-top: .8rem; }

  /* ── legs ── */
  .route-col { max-width: 880px; }
  .premiere {
    border: 1px solid color-mix(in srgb, var(--lantern) 45%, transparent);
    background: color-mix(in srgb, var(--lantern) 5%, transparent);
    border-radius: 6px;
    padding: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .premiere__kicker { color: var(--lantern); }
  .premiere__city { margin-top: .4rem; }
  .when {
    font-family: var(--mono);
    font-size: .78rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--bone-dim);
    margin-top: .8rem;
  }
  .premiere__body { margin-top: 1.1rem; max-width: 62ch; }

  .leg {
    border-top: 1px solid var(--rule);
    border-left: 3px solid var(--leg);
    padding: clamp(1.6rem, 4vw, 2.4rem) 0 clamp(1.6rem, 4vw, 2.4rem) clamp(1.2rem, 3vw, 1.8rem);
  }
  .leg__kicker {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--leg);
    filter: brightness(1.5);
    margin: 0;
  }
  .leg__name {
    font-size: clamp(1.9rem, 4.5vw, 3.1rem);
    margin: .5rem 0 .2rem;
  }
  .leg__window {
    font-family: var(--mono);
    font-size: .76rem;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--bone-dim);
    margin: 0;
  }
  .leg__intro { margin-top: 1rem; max-width: 62ch; }
  .cities {
    list-style: none;
    margin: 1.3rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
  }
  .cities li {
    font-family: var(--sans);
    font-size: .72rem;
    font-weight: 500;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--bone);
    padding: .5rem .9rem .42rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    white-space: nowrap;
  }
  .callout { margin-top: 1.2rem; max-width: 62ch; }
  .callout :global(strong) { color: var(--bone); }
  .route-note { margin-top: 1.4rem; font-style: italic; font-size: .92rem; }
</style>
