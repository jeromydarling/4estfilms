---
import Base from '../layouts/Base.astro';
import { company, strung, hnim, people } from '../data/site';
import { organization, website } from '../data/schema';
import Notify from '../components/Notify.astro';
import Trailer from '../components/Trailer.astro';
import Intro from '../components/Intro.astro';

// A slow montage behind the title — one frame from each shoot day.
const montage = [
  'key/nun.webp', 'key/hero-prayer.webp', 'key/nun-piano.webp',
  'key/candles.webp', 'key/reading.webp', 'key/hat-drama.webp',
  'key/portrait-woman.webp', 'key/two-men.webp', 'key/piano-boy.webp',
].map((file) => ({ file }));
export const prerender = true;
---

<Base
  title={company.seoTitle}
  description="4est Films is an independent film production company. Home of the 12-time award-winning short Strung and His Name is Michael, a supernatural Western musical coming late 2026."
  ogImage="/og/home.jpg"
  ogImageAlt="The 4est Films mark over a frame from His Name is Michael"
  schema={[organization, website]}
>
  <Intro />

  <!-- ── hero ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__plates" aria-hidden="true">
      {montage.map((m, i) => (
        <img
          src={`/stills/${m.file}`}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          style={`--i:${i}; --n:${montage.length}`}
        />
      ))}
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="wrap hero__body">
      <p class="timecode hero__tc" data-reveal>REC · {company.line}</p>
      <h1 class="hero__mark">
        <span class="sr">4est Films</span>
        <img
          src="/brand/4est-logo-bone.webp"
          alt=""
          width="1600"
          height="1316"
          fetchpriority="high"
        />
      </h1>
      <p class="lede hero__lede" data-reveal style="--delay:320ms">
        {company.tagline}.
      </p>
    </div>

    <div class="hero__foot wrap">
      <span class="timecode">Scroll</span>
      <span class="hero__line" aria-hidden="true"></span>
    </div>
  </section>

  <!-- ── the two films ────────────────────────────────────── -->
  <section class="section wrap">
    <p class="eyebrow" data-reveal>Two films</p>
    <h2 class="h2" data-reveal>
      One begins in a forest.<br />The other, on a frontier.
    </h2>
  </section>

  <!-- HNIM -->
  <a href="/films/his-name-is-michael/" class="feature feature--frontier">
    <div class="feature__art" data-parallax="0.09">
      <img
        src="/stills/key/schoolroom.webp"
        alt="A still from His Name is Michael"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="feature__body wrap">
      <p class="eyebrow eyebrow--accent" data-reveal>{hnim.release} · {hnim.genre}</p>
      <h2 class="h2 feature__title" data-reveal>{hnim.title}</h2>
      <p class="lede" data-reveal style="--delay:120ms">{hnim.logline}</p>
      <span class="link" data-reveal style="--delay:220ms">Enter Virginia City <span aria-hidden="true">→</span></span>
    </div>
  </a>

  <Trailer
    poster="/stills/key/trailer-poster.webp"
    label="Watch the trailer"
    youtube={hnim.youtube}
  />

  <!-- Strung -->
  <a href="/films/strung/" class="feature feature--forest">
    <div class="feature__art" data-parallax="0.09">
      <img
        src="/stills/strung/eric-forest.webp"
        alt="Eric in the forest, from Strung"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="feature__body wrap">
      <p class="eyebrow eyebrow--accent" data-reveal>{strung.year} · {strung.totalWins} awards</p>
      <h2 class="h2 feature__title" data-reveal>{strung.title}</h2>
      <p class="lede" data-reveal style="--delay:120ms">
        Lost in the forest of his own mind.
      </p>
      <span class="link" data-reveal style="--delay:220ms">Into the forest <span aria-hidden="true">→</span></span>
    </div>
  </a>

  <!-- ── the record ───────────────────────────────────────── -->
  <section class="section wrap record">
    <div>
      <p class="eyebrow" data-reveal>The record</p>
      <h2 class="h2" data-reveal>
        {strung.totalWins} wins.<br />{strung.festivalCount} festivals.
      </h2>
      <p class="dim record__note" data-reveal style="--delay:150ms">
        Recognized across eight international festivals, including Best in
        Fest and two Best First-Time Director honors.
      </p>
    </div>
    <ul class="record__list">
      {strung.featuredAwards.map(([prize, fest], i) => (
        <li class="laurel" data-reveal style={`--delay:${i * 55}ms`}>
          <span class="laurel__leaf" aria-hidden="true">❧</span>
          <span class="laurel__name">{prize}</span>
          <span class="laurel__prize">{fest}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── the people ───────────────────────────────────────── -->
  <section class="section wrap">
    <p class="eyebrow" data-reveal>Who makes them</p>
    <div class="people">
      {people.map((p, i) => (
        <article data-reveal style={`--delay:${i * 110}ms`}>
          <h3 class="h3">{p.name}</h3>
          <p class="eyebrow people__role">{p.roles}</p>
          <p class="dim">{p.bio}</p>
        </article>
      ))}
    </div>
    <p class="people__more" data-reveal>
      <a href="/about/" class="link">More about the company <span aria-hidden="true">→</span></a>
    </p>
  </section>
  <Notify
    film="company"
    heading="Know what comes next."
  />
</Base>

<style>
  /* ── hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__plates { position: absolute; inset: 0; z-index: -2; }
  .hero__plates img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    filter: grayscale(.55) contrast(1.15) brightness(.62);
    animation: plate calc(var(--n) * 4.2s) steps(1, end) infinite;
    animation-delay: calc(var(--i) * 4.2s);
  }
  @keyframes plate {
    0%, 11% { opacity: .95; }
    12%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__plates img { animation: none; }
    .hero__plates img:first-child { opacity: .9; }
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to bottom, rgba(8,8,10,.72) 0%, rgba(8,8,10,.35) 45%, var(--ink) 100%);
  }
  .hero__body { position: relative; }
  .hero__tc { margin: 0 0 2rem; }
  /* the drawn mark is the headline — no typographic stand-in beside it */
  .hero__mark { margin: 0; line-height: 0; }
  .hero__mark img {
    width: min(60ch, 62vw);
    max-width: 640px;
    height: auto;
    /* the mark resolves as the tape finishes seeking, echoing the sting */
    animation: mark-in 1.4s var(--ease) both;
  }
  @keyframes mark-in {
    from { opacity: 0; transform: translateY(1.2rem) scale(.99); filter: blur(6px); }
    to   { opacity: 1; transform: none; filter: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__mark img { animation: none; }
  }
  .hero__lede { margin-top: 3rem; }
  .hero__foot {
    position: absolute;
    inset: auto 0 2.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hero__line {
    height: 1px;
    width: min(22vw, 180px);
    background: linear-gradient(to right, var(--bone-faint), transparent);
    transform-origin: left;
    animation: pull 2.6s var(--ease) infinite;
  }
  @keyframes pull { 0%,100% { transform: scaleX(.4); } 50% { transform: scaleX(1); } }

  /* ── feature blocks ── */
  .feature {
    position: relative;
    display: grid;
    align-content: center;
    min-height: clamp(30rem, 82vh, 54rem);
    text-decoration: none;
    color: var(--bone);
    overflow: hidden;
    isolation: isolate;
    border-block: 1px solid var(--rule);
  }
  .feature__art { position: absolute; inset: -12% 0; z-index: -2; }
  .feature__art img {
    width: 100%; height: 100%;
    object-fit: cover;
    transform: translateY(var(--shift, 0)) scale(1.06);
    filter: grayscale(.35) brightness(.5);
    transition: filter .9s var(--ease), transform .9s var(--ease);
  }
  .feature:hover .feature__art img { filter: grayscale(0) brightness(.62); }
  .feature::before {
    content: '';
    position: absolute; inset: 0; z-index: -1;
  }
  .feature--frontier::before {
    background: linear-gradient(100deg, rgba(11,17,24,.94) 8%, rgba(27,42,61,.55) 55%, transparent 100%);
  }
  .feature--frontier { --accent: var(--lantern); }
  .feature--forest::before {
    background: linear-gradient(100deg, rgba(13,23,18,.94) 8%, rgba(29,52,39,.55) 55%, transparent 100%);
  }
  .feature--forest { --accent: var(--moss); }
  /* The frontier plate is a wide, bright exterior and survives the house dim.
     This one is a face in shade, and at brightness(.5) it stops being a face
     and becomes texture — so the forest panel carries a little more light. */
  .feature--forest .feature__art img { filter: grayscale(.2) brightness(.62); }
  .feature--forest:hover .feature__art img { filter: grayscale(0) brightness(.74); }
  .feature__body { max-width: 1500px; }
  .feature__title { margin-bottom: 1.4rem; }
  .feature .link { margin-top: 2.4rem; }

  /* ── record ── */
  .record {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    align-items: start;
  }
  .record__note { margin-top: 1.6rem; max-width: 34ch; }
  .record__list { list-style: none; margin: 0; padding: 0; }
  @media (max-width: 860px) { .record { grid-template-columns: 1fr; } }

  /* ── people ── */
  .people {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin-top: 2rem;
  }
  .people__role { margin: .7rem 0 1rem; }
  .people p { font-size: .95rem; }
  .people__more { margin-top: 3.5rem; }
</style>
