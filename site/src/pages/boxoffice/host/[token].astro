---
import BoxOffice from '../../../layouts/BoxOffice.astro';
import { env } from 'cloudflare:workers';
import { salesByCode, stopTotals } from '../../../lib/boxoffice-report';
import { money, showTime, type EventRow } from '../../../lib/boxoffice';

export const prerender = false;

/**
 * The parish coordinator's page.
 *
 * Read-only, no password: the link is the key, and it shows only what the
 * host has a stake in — how the room is filling, what their own codes
 * brought in, and what they are owed. No buyer names, no card fees, no
 * tour-side numbers. Regenerating the link from the report revokes this one.
 */
const token = String(Astro.params.token ?? '').toLowerCase();
const event = /^[0-9a-f]{32}$/.test(token)
  ? await env.DB.prepare(`SELECT * FROM bo_events WHERE host_token = ?1`).bind(token).first<EventRow>()
  : null;
if (!event) return new Response('Not found', { status: 404 });

const [[t], codes] = await Promise.all([stopTotals(event.id), salesByCode(event.id)]);
const used = codes.filter((c) => c.orders > 0);
const pct = t.capacity ? Math.round((t.attendees / t.capacity) * 100) : 0;
const city = `${event.city}${event.region ? `, ${event.region}` : ''}`;
const past = event.starts_at.slice(0, 10) < new Date().toISOString().slice(0, 10);
---

<BoxOffice title={`${event.venue} — host’s page`} bare>
  <p class="eyebrow">For the host · {showTime(event.starts_at)}</p>
  <h1>{event.venue}</h1>
  <p class="dim">{city} · {event.title}</p>

  <div class="counts">
    <div class="count"><span class="count__n">{t.attendees}</span><span class="count__l">of {t.capacity} seats</span></div>
    <div class="count"><span class="count__n">{pct}%</span><span class="count__l">of the house</span></div>
    <div class="count"><span class="count__n">{t.checked_in}</span><span class="count__l">walked in</span></div>
  </div>

  {!!t.sponsored_seats && (
    <p class="fine">
      <strong>{t.sponsored_seats}</strong> seats sponsored for foster and adoptive families at this screening
      {t.partner_name ? `, placed through ${t.partner_name}` : ''}.
    </p>
  )}

  <h2>Your codes</h2>
  <p class="fine">When your people buy with your code, we know they came through you.</p>
  {used.length ? (
    <table class="tbl">
      <thead><tr><th>Code</th><th class="r">Orders</th><th class="r">Seats</th></tr></thead>
      <tbody>{used.map((c) => (
        <tr><td class="mono">{c.code}</td><td class="r">{c.orders}</td><td class="r">{c.seats}</td></tr>
      ))}</tbody>
    </table>
  ) : <p class="dim">None used yet.</p>}

  <h2>What the parish receives</h2>
  <table class="tbl">
    <tbody>
      <tr><td>Tithe on the night’s net</td><td class="r">{money(t.tithe_cents)}</td></tr>
      <tr><td>Free-will offering, cash counted</td><td class="r">{money(t.offering_cents)}</td></tr>
      <tr><td>Free-will offering by card, {t.offerings} {t.offerings === 1 ? 'gift' : 'gifts'}, after card fees</td>
          <td class="r">{money(t.offering_card_cents - t.offering_fees_cents)}</td></tr>
      <tr class="sum"><td><strong>Total</strong></td><td class="r"><strong>{money(t.parish_cents)}</strong></td></tr>
      <tr><td>Paid so far</td><td class="r">{money(t.tithe_paid_cents + t.offering_paid_cents)}</td></tr>
      <tr><td>{t.parish_due_cents > 0 ? 'Still to come' : 'Outstanding'}</td><td class="r">{money(Math.max(0, t.parish_due_cents))}</td></tr>
    </tbody>
  </table>
  <p class="fine">
    {past
      ? 'The night is done; these are the final figures once the cash offering has been counted.'
      : 'These move as tickets sell. The tithe is settled after the night.'}
  </p>

  <p class="fine" style="margin-top:2rem">
    <a href={`/boxoffice/${event.slug}/`}>The ticket page</a> ·
    <a href={`/boxoffice/give/${event.slug}/sign/`}>The offering sign to print</a>
  </p>
  <p class="fine">This page is for you. The link is the key — please don’t post it.</p>
</BoxOffice>

<style>
  .counts { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin: 1.4rem 0; }
  .count { border: 1px solid var(--rule); border-radius: 4px; padding: .8rem; text-align: center; background: var(--ground-2); }
  .count__n { display: block; font-family: var(--display); font-size: 1.8rem; line-height: 1; }
  .count__l { font-family: var(--mono); font-size: .56rem; letter-spacing: .16em; text-transform: uppercase; color: var(--warm); }
  h2 { margin-top: 1.8rem; }
  .tbl { width: 100%; border-collapse: collapse; }
  .tbl td, .tbl th { padding: .5rem 0; border-bottom: 1px solid var(--rule); text-align: left; font-size: .95rem; }
  .tbl .r { text-align: right; }
  .tbl .sum td { border-top: 2px solid var(--rule); }
  .mono { font-family: var(--mono); }
</style>
