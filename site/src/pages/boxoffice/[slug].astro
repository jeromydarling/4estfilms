---
import BoxOffice from '../../layouts/BoxOffice.astro';
import { getEvent, getOffered, getProducts, soldAdmits } from '../../lib/boxoffice-db';
import { TOUR, money, showTime } from '../../lib/boxoffice';

export const prerender = false;

const { slug } = Astro.params;
const event = await getEvent(String(slug ?? ''));
if (!event) return new Response('Not found', { status: 404 });

const [products, offered, sold] = await Promise.all([
  getProducts(),
  getOffered(event.id),
  soldAdmits(event.id),
]);

const left = event.capacity - sold;
const soldOut = left <= 0;
const onSale = event.status === 'on_sale' && !soldOut;
// Same reason as the index: `<=` in a JSX expression starts an element.
const nearlyFull = left <= 25;

// Catalogue order, filtered to what this stop offers, priced with its
// overrides. The page never sees a price the server did not choose.
const items = [...products.values()]
  .filter((p) => offered.has(p.sku))
  .map((p) => ({ ...p, price_cents: offered.get(p.sku) ?? p.price_cents }))
  .sort((a, b) => a.sort - b.sort);

const seats = items.filter((p) => p.kind !== 'merch');
const addons = items.filter((p) => p.kind === 'merch');
const city = `${event.city}${event.region ? `, ${event.region}` : ''}`;
---

<BoxOffice
  title={`${event.title} — ${event.venue}, ${city}`}
  description={`${event.title} at ${event.venue}, ${city}. ${showTime(event.starts_at)}.`}
>
  <p class="eyebrow">{showTime(event.starts_at)}</p>
  <h1>{event.venue}</h1>
  <p class="where dim">{city}</p>

  {event.poster && (
    <img class="poster" src={event.poster} alt={`Key art for ${event.title}`}
         width="1200" height="630" loading="eager" />
  )}

  {event.blurb && <p class="blurb">{event.blurb}</p>}

  <dl class="facts">
    <div><dt>Film</dt><dd>{event.title}</dd></div>
    <div><dt>Showtime</dt><dd>{showTime(event.starts_at)}</dd></div>
    {event.doors_at && <div><dt>Doors</dt><dd>{showTime(event.doors_at)}</dd></div>}
    <div><dt>House</dt><dd>{event.capacity} seats</dd></div>
  </dl>

  {!onSale ? (
    <div class={`note ${soldOut ? 'note--bad' : ''}`}>
      {soldOut
        ? <>This stop is <strong>sold out</strong>. If we add a second showing you’ll hear it first —
            <a href="/#notify">put your address in</a>.</>
        : <>Tickets for this stop aren’t on sale yet.</>}
    </div>
  ) : (
    <form class="shop" data-shop data-slug={event.slug}>
      {nearlyFull && (
        <p class="note">Only {left} {left === 1 ? 'seat' : 'seats'} left in this house.</p>
      )}

      <h2>Tickets</h2>
      <div class="picks">
        {seats.map((p) => (
          <label class="pick" data-sku={p.sku} data-price={p.price_cents}
                 data-admits={p.admits} data-size={p.needs_size}>
            <span class="pick__head">
              <span class="pick__name">{p.name}</span>
              <span class="pick__price">{money(p.price_cents)}</span>
            </span>
            {p.blurb && <span class="pick__blurb dim">{p.blurb}</span>}
            {p.admits > 1 && <span class="pick__admits">Admits {p.admits}</span>}
            <span class="pick__qty">
              <button type="button" class="step" data-step="-1" aria-label={`One fewer ${p.name}`}>−</button>
              <output data-qty>0</output>
              <button type="button" class="step" data-step="1" aria-label={`One more ${p.name}`}>+</button>
            </span>
            {!!p.needs_size && (
              <span class="pick__size" hidden>
                <span class="fine">Shirt size</span>
                <span class="sizes">
                  {TOUR.sizes.map((s) => (
                    <button type="button" class="size" data-sizepick={s}>{s}</button>
                  ))}
                </span>
              </span>
            )}
          </label>
        ))}
      </div>

      {!!addons.length && (
        <>
          <h2>Add to it</h2>
          <div class="picks">
            {addons.map((p) => (
              <label class="pick pick--small" data-sku={p.sku} data-price={p.price_cents}
                     data-admits="0" data-size={p.needs_size}>
                <span class="pick__head">
                  <span class="pick__name">{p.name}</span>
                  <span class="pick__price">{money(p.price_cents)}</span>
                </span>
                <span class="pick__qty">
                  <button type="button" class="step" data-step="-1" aria-label={`One fewer ${p.name}`}>−</button>
                  <output data-qty>0</output>
                  <button type="button" class="step" data-step="1" aria-label={`One more ${p.name}`}>+</button>
                </span>
                {!!p.needs_size && (
                  <span class="pick__size" hidden>
                    <span class="fine">Shirt size</span>
                    <span class="sizes">
                      {TOUR.sizes.map((s) => (
                        <button type="button" class="size" data-sizepick={s}>{s}</button>
                      ))}
                    </span>
                  </span>
                )}
              </label>
            ))}
          </div>
        </>
      )}

      <h2>Promo code</h2>
      <p class="fine">
        If a parish or group sent you here, their code tells us they did.
      </p>
      <div class="promo">
        <label class="sr" for="promo">Promo code</label>
        <input id="promo" name="promo" type="text" autocapitalize="characters"
               autocomplete="off" spellcheck="false" placeholder="Optional" />
        <button type="button" class="btn btn--quiet promo__go" data-promo>Apply</button>
      </div>
      <p class="promo__msg" role="status" aria-live="polite" data-promomsg></p>

      <div class="total" data-total hidden>
        <div class="total__row"><span>Subtotal</span><span data-sub>$0</span></div>
        <div class="total__row total__row--off" data-offrow hidden>
          <span data-offlabel>Discount</span><span data-off>$0</span>
        </div>
        <div class="total__row total__row--due"><span>Total</span><span data-due>$0</span></div>
        <p class="fine" data-seats></p>
      </div>

      <button class="btn" type="submit" data-go disabled>Choose your tickets</button>
      <p class="shop__msg" role="status" aria-live="polite" data-msg></p>
      <p class="fine">
        Card, Apple Pay or Google Pay, handled by Stripe. Your tickets arrive by
        email with a code for each seat.
      </p>
    </form>
  )}
</BoxOffice>

<script>
  const shopForm = document.querySelector<HTMLFormElement>('[data-shop]');
  if (shopForm) {
    // Bound to a const the closures can see as non-null; narrowing on the
    // outer `if` does not survive into an async callback.
    const form = shopForm;
    const slug = form.dataset.slug!;
    const picks = [...form.querySelectorAll<HTMLElement>('.pick')];
    const go = form.querySelector<HTMLButtonElement>('[data-go]')!;
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;
    const promoInput = form.querySelector<HTMLInputElement>('#promo')!;
    const promoMsg = form.querySelector<HTMLElement>('[data-promomsg]')!;
    const totalBox = form.querySelector<HTMLElement>('[data-total]')!;

    const state = new Map<string, { qty: number; size: string | null }>();
    let appliedPromo = '';

    const money = (c: number) =>
      (c / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });

    const basket = () =>
      [...state.entries()]
        .filter(([, v]) => v.qty > 0)
        .map(([sku, v]) => ({ sku, qty: v.qty, size: v.size }));

    /** The server prices everything; this only decides what to ask it. */
    async function refresh() {
      const b = basket();
      const incomplete = b.some((l) => {
        const el = picks.find((p) => p.dataset.sku === l.sku)!;
        return el.dataset.size === '1' && !l.size;
      });

      if (!b.length) {
        totalBox.hidden = true;
        go.disabled = true;
        go.textContent = 'Choose your tickets';
        return;
      }
      if (incomplete) {
        totalBox.hidden = true;
        go.disabled = true;
        go.textContent = 'Pick a shirt size';
        return;
      }

      try {
        const res = await fetch('/api/boxoffice/quote', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, basket: b, promo: appliedPromo }),
        });
        const q = await res.json() as {
          ok?: boolean; error?: string; subtotal_cents?: number;
          discount_cents?: number; total_cents?: number; admits?: number;
        };
        if (!q.ok) {
          totalBox.hidden = true;
          go.disabled = true;
          msg.textContent = q.error ?? 'Something went wrong.';
          msg.dataset.state = 'err';
          return;
        }
        msg.textContent = '';
        msg.dataset.state = '';
        totalBox.hidden = false;
        form.querySelector('[data-sub]')!.textContent = money(q.subtotal_cents!);
        const offRow = form.querySelector<HTMLElement>('[data-offrow]')!;
        offRow.hidden = !q.discount_cents;
        form.querySelector('[data-off]')!.textContent = `−${money(q.discount_cents!)}`;
        form.querySelector('[data-due]')!.textContent = money(q.total_cents!);
        form.querySelector('[data-seats]')!.textContent =
          q.admits ? `${q.admits} ${q.admits === 1 ? 'seat' : 'seats'}` : 'Merchandise only';
        go.disabled = false;
        go.textContent = `Pay ${money(q.total_cents!)}`;
      } catch {
        msg.textContent = 'Network trouble. Try again.';
        msg.dataset.state = 'err';
      }
    }

    for (const el of picks) {
      const sku = el.dataset.sku!;
      const out = el.querySelector<HTMLOutputElement>('[data-qty]')!;
      const sizeBox = el.querySelector<HTMLElement>('.pick__size');
      state.set(sku, { qty: 0, size: null });

      el.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;

        const step = t.closest<HTMLElement>('[data-step]');
        if (step) {
          e.preventDefault();
          const s = state.get(sku)!;
          s.qty = Math.max(0, Math.min(50, s.qty + Number(step.dataset.step)));
          out.textContent = String(s.qty);
          el.classList.toggle('pick--on', s.qty > 0);
          if (sizeBox) sizeBox.hidden = s.qty === 0;
          if (s.qty === 0) {
            s.size = null;
            el.querySelectorAll('.size').forEach((b) => b.classList.remove('size--on'));
          }
          refresh();
          return;
        }

        const size = t.closest<HTMLElement>('[data-sizepick]');
        if (size) {
          e.preventDefault();
          const s = state.get(sku)!;
          s.size = size.dataset.sizepick!;
          el.querySelectorAll('.size').forEach((b) => b.classList.toggle('size--on', b === size));
          refresh();
        }
      });
    }

    form.querySelector('[data-promo]')!.addEventListener('click', async () => {
      appliedPromo = promoInput.value.trim().toUpperCase();
      promoInput.value = appliedPromo;
      if (!appliedPromo) { promoMsg.textContent = ''; refresh(); return; }
      const b = basket();
      // With an empty basket there is nothing to price, so check the code on
      // a single ticket just to tell the buyer whether it is good.
      const res = await fetch('/api/boxoffice/quote', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          slug,
          basket: b.length ? b : [{ sku: 'ticket', qty: 1 }],
          promo: appliedPromo,
        }),
      });
      const q = await res.json() as { ok?: boolean; error?: string; promo?: { partner: string } };
      if (q.ok && q.promo) {
        promoMsg.textContent = `Thanks — we’ll credit ${q.promo.partner}.`;
        promoMsg.dataset.state = 'ok';
      } else {
        promoMsg.textContent = q.error ?? 'That code isn’t valid.';
        promoMsg.dataset.state = 'err';
        appliedPromo = '';
      }
      refresh();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      go.disabled = true;
      msg.dataset.state = '';
      msg.textContent = 'Opening checkout…';
      try {
        const res = await fetch('/api/boxoffice/checkout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, basket: basket(), promo: appliedPromo }),
        });
        const body = await res.json() as { ok?: boolean; url?: string; error?: string };
        if (body.ok && body.url) { location.href = body.url; return; }
        msg.textContent = body.error ?? 'That didn’t go through. Try again?';
        msg.dataset.state = 'err';
      } catch {
        msg.textContent = 'Network trouble. Try again in a moment.';
        msg.dataset.state = 'err';
      } finally {
        go.disabled = false;
      }
    });
  }
</script>

<style>
  .where { margin: 0 0 1.2rem; font-size: 1.05rem; }
  .poster { display: block; width: 100%; border-radius: 4px; margin: 0 0 1.2rem; }
  .blurb { font-size: 1.05rem; margin: 0 0 1.4rem; }

  .facts { margin: 0 0 1.5rem; border-top: 1px solid var(--rule); }
  .facts > div {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: .55rem 0; border-bottom: 1px solid var(--rule);
  }
  dt {
    font-family: var(--mono); font-size: .6rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--warm);
  }
  dd { margin: 0; color: var(--parchment-dim); font-size: .95rem; text-align: right; }

  .picks { display: grid; gap: .7rem; }
  .pick {
    display: grid; gap: .3rem;
    border: 1px solid var(--rule); border-radius: 4px;
    padding: .9rem .95rem; background: var(--ground-2);
    cursor: pointer;
  }
  .pick--on { border-color: var(--brass); background: var(--ground-3); }
  .pick__head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .pick__name { font-family: var(--display); font-size: 1.08rem; }
  .pick__price { font-family: var(--mono); font-size: .95rem; color: var(--brass-lift); white-space: nowrap; }
  .pick__blurb { font-size: .92rem; }
  .pick__admits {
    font-family: var(--mono); font-size: .58rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--warm);
  }
  .pick--small .pick__name { font-size: 1rem; }

  /* 48px minimum on every tap target: this gets used in a dark lobby. */
  .pick__qty { display: flex; align-items: center; gap: .5rem; margin-top: .4rem; }
  .step {
    width: 3rem; height: 3rem; border-radius: 3px;
    background: var(--ground); border: 1px solid var(--rule);
    color: var(--parchment); font-size: 1.4rem; line-height: 1; cursor: pointer;
  }
  .step:hover { border-color: var(--brass); }
  [data-qty] {
    min-width: 2.5rem; text-align: center; font-family: var(--mono);
    font-size: 1.1rem; color: var(--parchment);
  }

  .pick__size { display: block; margin-top: .5rem; }
  .sizes { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .3rem; }
  .size {
    min-width: 3rem; height: 2.9rem; border-radius: 3px;
    background: var(--ground); border: 1px solid var(--rule);
    color: var(--parchment); font-family: var(--mono); font-size: .8rem; cursor: pointer;
  }
  .size--on { border-color: var(--brass); color: var(--brass-lift); background: var(--ground-3); }

  .promo { display: flex; gap: .5rem; }
  .promo input { flex: 1 1 auto; text-transform: uppercase; }
  .promo__go { width: auto; flex: 0 0 auto; padding-inline: 1.2rem; }
  .promo__msg { font-size: .9rem; min-height: 1.3em; margin: .5rem 0 0; color: var(--parchment-dim); }
  .promo__msg[data-state='err'] { color: #e9b4b4; }
  .promo__msg[data-state='ok'] { color: var(--ok); }

  .total {
    margin: 1.6rem 0 1rem; border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule); padding: .8rem 0;
  }
  .total__row { display: flex; justify-content: space-between; gap: 1rem; padding: .25rem 0; }
  .total__row--off { color: var(--ok); }
  .total__row--due { font-family: var(--display); font-size: 1.3rem; padding-top: .5rem; }
  .total .fine { margin: .3rem 0 0; }

  .shop__msg { font-size: .92rem; min-height: 1.3em; margin: .7rem 0 0; color: var(--parchment-dim); }
  .shop__msg[data-state='err'] { color: #e9b4b4; }

  .sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
