---
import Base from '../../layouts/Base.astro';
import { strung } from '../../data/site';
import Notify from '../../components/Notify.astro';
import YouTube from '../../components/YouTube.astro';

// The old "Frames" grid was mostly trailer title cards, quote graphics and a
// unit photo of the crew in modern clothes. Of the seven images we hold, one
// is an actual frame from the film — it is the hero below. The rest of the
// grid comes back when the full-resolution stills arrive; until then the page
// shows the two pieces of official key art rather than padding.
const hero = '2020-12-17_CI4q_yUgNeX_01.jpg';
const poster = '2020-12-21_CJE3HIjg9Lx_01.jpg';
export const prerender = true;
---

<Base
  world="forest"
  title="Strung (2019) — 12-time award-winning short film from 4est Films"
  description="Lost in the forest of his own mind, Eric must rely on a nine-year-old boy to battle withdrawal and break his family's cycle of addiction. Twelve wins across eight festivals."
>
  <!-- ── hero ── -->
  <section class="hero">
    <div class="hero__art" data-parallax="0.06">
      <img src={`/stills/strung/${hero}`} alt="" loading="eager" decoding="async" />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="wrap hero__body">
      <p class="eyebrow eyebrow--accent" data-reveal>
        {strung.year} · {strung.runtimeNote} · {strung.totalWins} awards
      </p>
      <h1 class="display" data-reveal style="--delay:80ms">Strung</h1>
      <p class="lede hero__lede" data-reveal style="--delay:240ms">
        Lost in the forest of his own mind.
      </p>
    </div>
  </section>

  <!-- ── trailer ── renders as soon as strung.youtube holds the official ID -->
  {strung.youtube && (
    <YouTube
      id={strung.youtube}
      title="Strung — official trailer"
      poster="/stills/strung/2020-12-21_CJE3HIjg9Lx_01.jpg"
      caption="Strung — official trailer."
    />
  )}

  <!-- ── logline ── -->
  <section class="section wrap">
    <p class="eyebrow" data-reveal>The story</p>
    <p class="logline" data-reveal>{strung.logline}</p>
    <p class="dim logline__note" data-reveal style="--delay:140ms">{strung.statement}</p>
  </section>

  <!-- ── three headlines ── -->
  <section class="section wrap">
    <div class="heads">
      {strung.headlines.map((h, i) => (
        <article class="head" data-reveal style={`--delay:${i * 140}ms`}>
          <p class="head__stat">{h.stat}</p>
          <p class="head__of">{h.of}</p>
          <p class="dim">{h.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── awards ── -->
  <section class="section wrap">
    <p class="eyebrow" data-reveal>Selected honors</p>
    <ol class="awards">
      {strung.featuredAwards.map(([prize, fest], i) => (
        <li class="award" data-reveal style={`--delay:${i * 70}ms`}>
          <span class="award__leaf" aria-hidden="true">❧</span>
          <p class="award__prize">{prize}</p>
          <p class="award__fest">{fest}</p>
        </li>
      ))}
    </ol>
    <div class="awards__foot" data-reveal>
      <p class="awards__total">
        {strung.totalWins} awards across {strung.festivalCount} festivals
      </p>
      <a class="link" href={strung.imdbAwards} target="_blank" rel="noopener">
        View all awards <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ── key art ── -->
  <section class="section wrap art">
    <figure class="art__cell" data-reveal>
      <img src={`/stills/strung/${poster}`} alt="Strung — official poster" loading="lazy" decoding="async" />
    </figure>
    <div class="art__side">
      <p class="eyebrow" data-reveal>Key art</p>
      <p class="lede" data-reveal style="--delay:100ms">
        The poster that carried the film's first festival laurel.
      </p>
      <p class="dim art__note" data-reveal style="--delay:180ms">
        Official Selection, Top Shorts Film Festival, 2020 — the first of
        {strung.totalWins} wins across {strung.festivalCount} festivals.
      </p>
    </div>
  </section>

  <!-- ── credits ── -->
  <section class="section wrap">
    <div class="cols">
      <div>
        <p class="eyebrow" data-reveal>Directed by</p>
        <ul class="plain" data-reveal>{strung.directors.map((d) => <li>{d}</li>)}</ul>
        <p class="eyebrow" data-reveal style="--delay:60ms">Co-directed by</p>
        <ul class="plain" data-reveal style="--delay:60ms">{strung.coDirectors.map((d) => <li>{d}</li>)}</ul>
        <p class="eyebrow" data-reveal style="--delay:120ms">Written by</p>
        <ul class="plain" data-reveal style="--delay:120ms">{strung.writers.map((d) => <li>{d}</li>)}</ul>
        <p class="eyebrow" data-reveal style="--delay:180ms">Produced by</p>
        <ul class="plain" data-reveal style="--delay:180ms">{strung.producers.map((d) => <li>{d}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow" data-reveal>Cast</p>
        <ul class="plain" data-reveal>
          {strung.cast.map(([who, role]) => (
            <li>{who}{role ? <span class="dim"> — {role}</span> : null}</li>
          ))}
        </ul>
        <p class="eyebrow" data-reveal style="--delay:120ms">Crew</p>
        <ul class="plain" data-reveal style="--delay:120ms">
          {strung.crew.map(([role, who]) => (
            <li><span class="dim">{role} — </span>{who}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── the premiere / the point ── -->
  <section class="section wrap give">
    <p class="eyebrow eyebrow--accent" data-reveal>Why it was made</p>
    <p class="lede give__lede" data-reveal>{strung.closing}</p>
    <div class="help" data-reveal style="--delay:140ms">
      <p class="help__label">{strung.helpline.label}</p>
      <p class="help__num"><a href={strung.helpline.href}>{strung.helpline.number}</a></p>
      <p class="dim help__note">{strung.helpline.note}</p>
    </div>
    <p class="dim future" data-reveal style="--delay:200ms">{strung.future}</p>
  </section>
  <Notify
    film="strung"
    heading="Follow the feature."
    note="A feature-length Strung is in development. We will write when there is news."
  />
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: end;
    padding-bottom: clamp(3rem, 9vw, 7rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__art { position: absolute; inset: -10% 0; z-index: -2; }
  .hero__art img {
    width: 100%; height: 100%;
    object-fit: cover;
    transform: translateY(var(--shift, 0)) scale(1.08);
    filter: brightness(.46) saturate(.75) hue-rotate(-8deg);
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(to bottom, rgba(13,23,18,.5), rgba(13,23,18,.22) 40%, var(--forest-deep) 96%),
      radial-gradient(70% 55% at 25% 90%, rgba(74,107,82,.2), transparent 70%);
  }
  .hero__lede { margin-top: 2rem; }

  .logline {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3.4vw, 2.6rem);
    line-height: 1.22;
    font-variation-settings: 'SOFT' 20, 'WONK' 0, 'opsz' 60;
    max-width: 26ch;
    margin: 1rem 0 0;
  }
  .logline__note { margin-top: 2rem; max-width: 46ch; font-size: .95rem; }

  .heads {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .head { border-top: 1px solid var(--rule); padding-top: 1.6rem; }
  .head__stat {
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    line-height: 1;
    margin: 0;
    color: var(--blood-lift);
  }
  .head__of {
    font-size: .72rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--bone-faint);
    margin: .7rem 0 1.2rem;
  }
  .head .dim { font-size: .93rem; }

  /* two rows of three, collapsing to two then one */
  .awards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (max-width: 860px) { .awards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .awards { grid-template-columns: 1fr; } }

  .award {
    background: var(--ground);
    padding: clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    align-content: start;
    gap: .5rem;
  }
  .award__leaf { color: var(--blood-lift); font-size: 1.15rem; line-height: 1; }
  .award__prize {
    font-family: var(--display);
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    line-height: 1.1;
    margin: .3rem 0 0;
    text-wrap: balance;
  }
  .award__fest {
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--bone-dim);
    margin: 0;
  }

  .awards__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  .awards__total {
    font-family: var(--display);
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    margin: 0;
  }

  .art {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    align-items: center;
  }
  @media (max-width: 760px) { .art { grid-template-columns: 1fr; } }
  .art__cell { margin: 0; }
  .art__cell img {
    width: 100%;
    filter: brightness(.92);
    transition: filter .6s var(--ease);
  }
  .art__cell:hover img { filter: none; }
  .art__note { margin-top: 1.6rem; font-size: .92rem; max-width: 40ch; }

  .cols {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .plain { list-style: none; margin: 0 0 2.2rem; padding: 0; }
  .plain li {
    font-family: var(--display);
    font-size: 1.1rem;
    padding: .35rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .plain li .dim { font-family: var(--sans); font-size: .82rem; }

  .give__lede { max-width: 40ch; margin-bottom: 3rem; }
  .help {
    border-left: 2px solid var(--accent);
    padding-left: clamp(1.2rem, 3vw, 2.4rem);
    max-width: 46ch;
  }
  .help__label { font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; color: var(--bone-faint); margin: 0; }
  .help__num { font-family: var(--display); font-size: clamp(1.8rem, 4vw, 2.6rem); margin: .5rem 0; }
  .help__num a { text-decoration: none; color: var(--blood-lift); }
  .help__note { font-size: .9rem; margin: 0; }
  .future { margin-top: 3rem; font-size: .9rem; }
</style>
